{
  "name": "vpai-crm-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run verificar && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "verificar": "npm run lint && node scripts/verificar-columnas.mjs && node scripts/verificar-catalogos-como-texto.mjs && node scripts/verificar-indices-sql.mjs",
    "verificar:columnas": "node scripts/verificar-columnas.mjs",
    "verificar:catalogos": "node scripts/verificar-catalogos-como-texto.mjs",
    "verificar:indices": "node scripts/verificar-indices-sql.mjs",
    "verificar:edge": "deno check supabase/functions/*/index.ts && deno lint --rules-exclude=no-import-prefix,no-inner-declarations supabase/functions/"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.11.1",
    "eslint-plugin-react": "^7.36.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.9.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5"
  }
}
